<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_fondo">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="FRASE DEL DÍA" android:textSize="10sp" android:textStyle="bold"
        android:textColor="#62B7AB" android:letterSpacing="0.1" />
    <TextView
        android:id="@+id/w_frase"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:maxLines="5" android:ellipsize="end"
        android:textColor="#EDE6D6" android:textSize="15sp" android:textStyle="italic" />
    <TextView
        android:id="@+id/w_frase_l"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:maxLines="1" android:ellipsize="end"
        android:textColor="#A9B7B3" android:textSize="11sp" />
</LinearLayout>
